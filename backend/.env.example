# Database Configuration
MONGO_URL=mongodb://localhost:27017/
DB_NAME=retoerp

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SMS Configuration (Choose one provider)
SMS_PROVIDER=mock  # Options: mock, msg91
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_SENDER_ID=your_sender_id_here

# Email Configuration (Choose one provider)
EMAIL_PROVIDER=mock  # Options: mock, sendgrid, aws_ses

# SendGrid Configuration
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# AWS SES Configuration (Alternative to SendGrid)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_SES_FROM_EMAIL=noreply@yourdomain.com

# WhatsApp Configuration (Future)
WHATSAPP_PROVIDER=mock  # Always mock for now
